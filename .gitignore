# Environment variables and secrets
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Node dependencies and generated output
**/node_modules/
**/dist/
**/build/
**/coverage/
**/.cache/
**/.turbo/
**/*.tsbuildinfo

# Runtime data and uploaded media
dashboard-backend/storage/screencast-db.json
dashboard-backend/storage/media/*
dashboard-backend/storage/thumbnails/*
dashboard-backend/storage/downloads/*
!dashboard-backend/storage/media/.gitkeep
!dashboard-backend/storage/thumbnails/.gitkeep
!dashboard-backend/storage/downloads/.gitkeep

# Android and Gradle generated files
android-player/.android-sdk/
android-player/.gradle/
android-player/local.properties
android-player/**/build/
android-player/**/*.apk
android-player/**/*.aab
android-player/**/*.apks
android-player/*.hprof
android-player/**/*.hprof
android-player/captures/
android-player/.cxx/
android-player/**/.externalNativeBuild/

# Signing credentials
**/*.jks
**/*.keystore
**/keystore.properties

# Logs and temporary files
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/*.pid
**/*.pid.lock
**/.tmp/
**/.temp/

# IDE and operating-system files
.DS_Store
Thumbs.db
Desktop.ini
**/.idea/
**/.vscode/*
!**/.vscode/extensions.json
!**/.vscode/settings.json
!**/.vscode/tasks.json
!**/.vscode/launch.json
**/*.iml
**/*.suo
**/*.swp
**/*.orig.*

# Local agent/tooling state
.agents/
.codex/
.codex-temp/
**/.codex-temp/
